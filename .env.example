# 复制为 .env 后按需修改。所有值均为演示用，生产请替换为强随机值。
#
# 必填字段（标注 ★）请替换为真实值，否则部署成功后 agent 无法调用 LLM。

# ---- 镜像 ----
OCTOBUS_IMAGE=ghcr.io/chaitin/octobus:latest
AGENT_COMPOSE_IMAGE=ghcr.io/chaitin/agent-compose:latest
AGENT_COMPOSE_FRONTEND_IMAGE=ghcr.io/chaitin/agent-compose-ui:latest

# ---- OctoBus capset 访问令牌 ----
# init-octobus.sh 会把它写入 capset；capproxy 转发时用此 token 鉴权。
OCTOBUS_BI_CAPSET_TOKEN=bi-capset-demo-token-0001

# ---- LLM Provider: Anthropic-compatible (DeepSeek) ----
# ★ 请替换为你的 API Key
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_API_KEY=sk-your-deepseek-api-key-here
ANTHROPIC_MODEL=deepseek-v4-flash
